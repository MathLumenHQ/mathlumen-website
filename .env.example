# ============================================
# MathLumen Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# Database (Supabase)
# Get from: Supabase Dashboard → Settings → Database → Connection string (URI format)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Supabase
# Get from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# App
NEXT_PUBLIC_APP_URL=https://mathlumen.com
NEXT_PUBLIC_SITE_NAME=MathLumen

# ImageKit (CDN Image Management)
# Get from: imagekit.io → Settings → API Keys
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/[YOUR_ID]
IMAGEKIT_PUBLIC_KEY=public_[YOUR_KEY]
IMAGEKIT_PRIVATE_KEY=private_[YOUR_KEY]
